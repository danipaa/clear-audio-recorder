{
  "appId": "com.daxator.clearaudiorecorder",
  "appName": "Clear Audio Recorder",
  "webDir": "www",
  "backgroundColor": "#08090a",
  "android": {
    "backgroundColor": "#08090a",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
