{
  "name": "clear-audio-recorder",
  "version": "1.0.0",
  "description": "Clear Audio Recorder: record, one-tap noise removal, voice effects. Android app built with Capacitor.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs preview",
    "test": "node tests/engine.test.cjs",
    "sync": "node scripts/build.mjs www && npx cap sync android",
    "icons": "npx capacitor-assets generate --android --iconBackgroundColor \"#060709\" --iconBackgroundColorDark \"#060709\" --splashBackgroundColor \"#060709\" --splashBackgroundColorDark \"#060709\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "lamejs": "^1.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  },
  "private": true
}
